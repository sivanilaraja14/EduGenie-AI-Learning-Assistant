# Required for Gemini-powered features.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used for Q&A, quiz, summarization and learning paths.
GEMINI_MODEL=gemini-1.5-pro

# Local model used for concept explanations.
EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M

# local = use LaMini model first
# gemini = use Gemini for explanations
EXPLANATION_BACKEND=local

# Allow Gemini fallback if local explanation fails.
ALLOW_EXPLANATION_FALLBACK=true

# Maximum input size.
MAX_INPUT_CHARS=30000